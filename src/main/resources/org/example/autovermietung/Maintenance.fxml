<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.lang.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.autovermietung.Controller.MaintenanceController"
            style="-fx-background-color: #000000;"
            prefHeight="1200"
            prefWidth="1440">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #000000;">
            <padding>
                <Insets top="40" right="50" bottom="20" left="50"/>
            </padding>

            <!-- Logo and Brand -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <ImageView fitHeight="30.0" fitWidth="60.0" preserveRatio="true">
                    <image>
                        <Image url="@assets/Sevenst_logo.png"/>
                    </image>
                </ImageView>
                <Label text="Sevenst" textFill="white">
                    <font>
                        <Font name="Pretendard Medium" size="20.0"/>
                    </font>
                </Label>
            </HBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- User Info -->
            <Label text="Angemeldet als [Username]"
                   style="-fx-text-fill: #CCCCCC; -fx-font-size: 14px;">
                <font>
                    <Font name="Pretendard Regular" size="14.0"/>
                </font>
            </Label>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #000000;">
            <padding>
                <Insets top="20" right="50" bottom="40" left="50"/>
            </padding>

            <!-- Title and Buttons Row -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Wartungen" textFill="white">
                    <font>
                        <Font name="Pretendard Bold" size="48.0"/>
                    </font>
                </Label>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Add New Button -->
                <Button fx:id="addButton"
                        text="+ Neuer Eintrag"
                        onAction="#handleAddNew"
                        style="-fx-background-color: #EB512B;
                               -fx-text-fill: white;
                               -fx-padding: 10 24 10 24;
                               -fx-background-radius: 4;
                               -fx-cursor: hand;">
                    <font>
                        <Font name="Pretendard Medium" size="14.0"/>
                    </font>
                </Button>

                <!-- Back Button -->
                <Button fx:id="backButton"
                        text="← Zurück zum Dashboard"
                        onAction="#handleBackToDashboard"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #CCCCCC;
                               -fx-border-color: #555555;
                               -fx-border-width: 1px;
                               -fx-border-radius: 4;
                               -fx-background-radius: 4;
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;">
                    <font>
                        <Font name="Pretendard Medium" size="14.0"/>
                    </font>
                </Button>
            </HBox>

            <Region prefHeight="40"/>  <!-- Spacing -->

            <!-- Maintenance Table -->
            <TableView fx:id="maintenanceTable"
                       style="-fx-background-color: #000000;
                              -fx-control-inner-background: #000000;
                              -fx-table-cell-border-color: #333333;
                              -fx-border-color: #333333;">
                <columns>
                    <TableColumn fx:id="herstellerColumn"
                                 text="Hersteller"
                                 prefWidth="200"
                                 style="-fx-text-fill: white; -fx-alignment: CENTER-LEFT;">
                        <styleClass>
                            <String fx:value="table-column"/>
                        </styleClass>
                    </TableColumn>

                    <TableColumn fx:id="modellColumn"
                                 text="Modell"
                                 prefWidth="200"
                                 style="-fx-text-fill: white; -fx-alignment: CENTER-LEFT;">
                        <styleClass>
                            <String fx:value="table-column"/>
                        </styleClass>
                    </TableColumn>

                    <TableColumn fx:id="baujahrColumn"
                                 text="Baujahr"
                                 prefWidth="150"
                                 style="-fx-text-fill: white; -fx-alignment: CENTER-LEFT;">
                        <styleClass>
                            <String fx:value="table-column"/>
                        </styleClass>
                    </TableColumn>

                    <TableColumn fx:id="oilKmColumn"
                                 text="Ölwechsel (km)"
                                 prefWidth="200"
                                 style="-fx-text-fill: white; -fx-alignment: CENTER-LEFT;">
                        <styleClass>
                            <String fx:value="table-column"/>
                        </styleClass>
                    </TableColumn>

                    <TableColumn fx:id="engineDamageColumn"
                                 text="Motorschaden"
                                 prefWidth="200"
                                 style="-fx-text-fill: white; -fx-alignment: CENTER-LEFT;">
                        <styleClass>
                            <String fx:value="table-column"/>
                        </styleClass>
                    </TableColumn>

                    <TableColumn fx:id="repairsColumn"
                                 text="Reparaturen"
                                 prefWidth="240"
                                 style="-fx-text-fill: white; -fx-alignment: CENTER-LEFT;">
                        <styleClass>
                            <String fx:value="table-column"/>
                        </styleClass>
                    </TableColumn>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>