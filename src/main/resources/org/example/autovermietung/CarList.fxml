<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.autovermietung.Controller.CarListController"
            style="-fx-background-color: #0d0d0d;">

    <VBox spacing="20"
          AnchorPane.topAnchor="20"
          AnchorPane.leftAnchor="20"
          AnchorPane.rightAnchor="20"
          AnchorPane.bottomAnchor="60">

        <Label text="Meine Garage"
               style="-fx-text-fill: white; -fx-font-size: 30; -fx-font-weight: bold;" />

        <ScrollPane fx:id="scrollPane"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="NEVER"
                    fitToHeight="true"
                    pannable="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">

            <!-- Wichtig: Inhalt transparent machen (gegen weißen/grauen Block) -->
            <content>
                <GridPane fx:id="carGrid"
                          hgap="25"
                          vgap="25"
                          style="-fx-background-color: transparent;">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                </GridPane>
            </content>

        </ScrollPane>

        <HBox spacing="20">
            <Button text="Auto hinzufügen" onAction="#handleAddCar"/>
            <Button text="Zurück" onAction="#handleBack"/>
        </HBox>

    </VBox>

</AnchorPane>
