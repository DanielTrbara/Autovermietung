<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.autovermietung.Controller.MaintenanceAddController"
            style="-fx-background-color: #000000;"
            prefHeight="1200"
            prefWidth="1440">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #000000;">
            <padding>
                <Insets top="40" right="50" bottom="20" left="50"/>
            </padding>

            <!-- Logo and Brand -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <ImageView fitHeight="30.0" fitWidth="60.0" preserveRatio="true">
                    <image>
                        <Image url="@assets/Sevenst_logo.png"/>
                    </image>
                </ImageView>
                <Label text="Sevenst" textFill="white">
                    <font>
                        <Font name="Pretendard Medium" size="20.0"/>
                    </font>
                </Label>
            </HBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- User Info -->
            <Label text="Angemeldet als [Username]"
                   style="-fx-text-fill: #CCCCCC; -fx-font-size: 14px;">
                <font>
                    <Font name="Pretendard Regular" size="14.0"/>
                </font>
            </Label>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #000000;">
            <padding>
                <Insets top="20" right="50" bottom="40" left="50"/>
            </padding>

            <!-- Title and Back Button -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Neuer Wartungseintrag" textFill="white">
                    <font>
                        <Font name="Pretendard Bold" size="48.0"/>
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Back Button -->
                <Button fx:id="backButton"
                        text="← Zurück zur Übersicht"
                        onAction="#handleBackToList"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #CCCCCC;
                               -fx-border-color: #555555;
                               -fx-border-width: 1px;
                               -fx-border-radius: 4;
                               -fx-background-radius: 4;
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;">
                    <font>
                        <Font name="Pretendard Medium" size="14.0"/>
                    </font>
                </Button>
            </HBox>

            <Region prefHeight="60"/>

            <!-- Form Card -->
            <VBox spacing="30" style="-fx-background-color: #0a0a0a; -fx-background-radius: 8; -fx-padding: 40;"
                  maxWidth="800">

                <!-- Form Title -->
                <Label text="Fahrzeug- und Wartungsinformationen" textFill="white">
                    <font>
                        <Font name="Pretendard SemiBold" size="22.0"/>
                    </font>
                </Label>

                <!-- Form Fields -->
                <GridPane hgap="30" vgap="25">

                    <!-- Fahrzeug auswählen -->
                    <Label text="Fahrzeug *" textFill="#999999" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <font>
                            <Font name="Pretendard Medium" size="14.0"/>
                        </font>
                    </Label>
                    <ComboBox fx:id="carComboBox"
                              promptText="Wählen Sie ein Fahrzeug aus"
                              style="-fx-background-color: #1a1a1a;
                                     -fx-text-fill: white;
                                     -fx-prompt-text-fill: #666666;
                                     -fx-border-color: #333333;
                                     -fx-border-radius: 4;
                                     -fx-background-radius: 4;"
                              prefWidth="400"
                              GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <styleClass>
                            <String fx:value="combo-box"/>
                        </styleClass>
                    </ComboBox>

                    <!-- Ölwechsel -->
                    <Label text="Ölwechsel (km) *" textFill="#999999" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <font>
                            <Font name="Pretendard Medium" size="14.0"/>
                        </font>
                    </Label>
                    <TextField fx:id="oilKmField"
                               promptText="z.B. 8000"
                               style="-fx-background-color: #1a1a1a;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #666666;
                                      -fx-border-color: #333333;
                                      -fx-border-radius: 4;
                                      -fx-background-radius: 4;
                                      -fx-padding: 10;"
                               GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <font>
                            <Font name="Pretendard Regular" size="14.0"/>
                        </font>
                    </TextField>

                    <!-- Motorschaden -->
                    <Label text="Motorschaden" textFill="#999999" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <font>
                            <Font name="Pretendard Medium" size="14.0"/>
                        </font>
                    </Label>
                    <TextField fx:id="engineDamageField"
                               promptText="z.B. - oder Beschreibung"
                               style="-fx-background-color: #1a1a1a;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #666666;
                                      -fx-border-color: #333333;
                                      -fx-border-radius: 4;
                                      -fx-background-radius: 4;
                                      -fx-padding: 10;"
                               GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <font>
                            <Font name="Pretendard Regular" size="14.0"/>
                        </font>
                    </TextField>

                    <!-- Reparaturen -->
                    <Label text="Service-Kontakt" textFill="#999999" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <font>
                            <Font name="Pretendard Medium" size="14.0"/>
                        </font>
                    </Label>
                    <TextField fx:id="repairsField"
                               promptText="z.B. Telefonnummer"
                               style="-fx-background-color: #1a1a1a;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #666666;
                                      -fx-border-color: #333333;
                                      -fx-border-radius: 4;
                                      -fx-background-radius: 4;
                                      -fx-padding: 10;"
                               GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <font>
                            <Font name="Pretendard Regular" size="14.0"/>
                        </font>
                    </TextField>

                    <!-- Column Constraints -->
                    <columnConstraints>
                        <ColumnConstraints minWidth="180" prefWidth="180"/>
                        <ColumnConstraints minWidth="400" prefWidth="400"/>
                    </columnConstraints>
                </GridPane>

                <Separator style="-fx-background-color: #333333;"/>

                <!-- Error Message -->
                <Label fx:id="errorLabel"
                       textFill="#EB512B"
                       visible="false"
                       wrapText="true">
                    <font>
                        <Font name="Pretendard Regular" size="14.0"/>
                    </font>
                </Label>

                <!-- Action Buttons -->
                <HBox spacing="15">
                    <Button fx:id="saveButton"
                            text="Speichern"
                            onAction="#handleSave"
                            style="-fx-background-color: #EB512B;
                                   -fx-text-fill: white;
                                   -fx-padding: 12 32 12 32;
                                   -fx-background-radius: 4;
                                   -fx-cursor: hand;">
                        <font>
                            <Font name="Pretendard Medium" size="14.0"/>
                        </font>
                    </Button>

                    <Button text="Abbrechen"
                            onAction="#handleBackToList"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: white;
                                   -fx-border-color: #555555;
                                   -fx-border-width: 1px;
                                   -fx-border-radius: 4;
                                   -fx-background-radius: 4;
                                   -fx-padding: 12 24 12 24;
                                   -fx-cursor: hand;">
                        <font>
                            <Font name="Pretendard Medium" size="14.0"/>
                        </font>
                    </Button>
                </HBox>

                <!-- Required Fields Note -->
                <Label text="* Pflichtfelder" textFill="#666666">
                    <font>
                        <Font name="Pretendard Regular" size="12.0"/>
                    </font>
                </Label>

            </VBox>

        </VBox>
    </center>

</BorderPane>