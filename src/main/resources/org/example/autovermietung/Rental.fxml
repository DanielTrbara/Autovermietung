<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.autovermietung.Controller.RentalController"
            prefWidth="1100" prefHeight="700">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="12" right="12" bottom="8" left="12"/>
            </padding>

            <Label text="Auto vermieten"
                   style="-fx-font-size: 18px; -fx-font-weight: 800;"/>

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Kunde:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbKunde" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Auto:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbAuto" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Start:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpStart" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Ende:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpEnd" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Zurück" onAction="#handleBack"/>
                <Button text="Vermieten" onAction="#onVermieten"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="8" right="12" bottom="12" left="12"/>
            </padding>

            <Label text="Aktive Vermietungen"
                   style="-fx-font-size: 14px; -fx-font-weight: 700;"/>

            <TableView fx:id="tableRentals" maxWidth="1100">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <columns>
                    <TableColumn fx:id="colKunde" text="Kunde" prefWidth="220"/>
                    <TableColumn fx:id="colAuto" text="Auto" prefWidth="300"/>
                    <TableColumn fx:id="colStart" text="Start" prefWidth="160"/>
                    <TableColumn fx:id="colEnd" text="Ende" prefWidth="160"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Rückgabe (löscht Rental)" onAction="#onRueckgabe"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>